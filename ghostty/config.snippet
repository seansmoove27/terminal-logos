# terminal-logos: faint dotted Ghostty ghost centered in every idle pane.
# Paste into ~/.config/ghostty/config. Ghostty doesn't expand ~ here, so use your full home path.
# CLI wrappers (claude/devin/opencode/codex) draw their own logo with an opaque backing on top.
background-image = /Users/YOU/.local/share/terminal-logos/ghostty-logo-bg.png
background-image-position = center
background-image-fit = contain
background-image-opacity = 1
